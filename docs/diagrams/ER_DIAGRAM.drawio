        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    USERS {\n        INTEGER id PK\n        VARCHAR name\n        VARCHAR email UK\n        VARCHAR password_hash\n        VARCHAR role\n        TIMESTAMP created_at\n    }\n\n    ISSUES {\n        INTEGER id PK\n        VARCHAR title\n        TEXT description\n        VARCHAR category\n        VARCHAR priority\n        VARCHAR severity\n        VARCHAR status\n        VARCHAR location\n        DECIMAL latitude\n        DECIMAL longitude\n        INTEGER reported_by FK\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    ISSUE_IMAGES {\n        INTEGER image_id PK\n        INTEGER issue_id FK\n        VARCHAR image_url\n        TIMESTAMP uploaded_at\n    }\n\n    DEPARTMENTS {\n        INTEGER department_id PK\n        VARCHAR department_name UK\n        TEXT description\n    }\n\n    STAFF {\n        INTEGER staff_id PK\n        INTEGER department_id FK\n        VARCHAR name\n        VARCHAR email UK\n        VARCHAR role\n        VARCHAR phone\n    }\n\n    ASSIGNMENTS {\n        INTEGER assignment_id PK\n        INTEGER issue_id FK\n        INTEGER department_id FK\n        INTEGER staff_id FK\n        TIMESTAMP assigned_at\n        VARCHAR assignment_status\n    }\n\n    STATUS_HISTORY {\n        INTEGER history_id PK\n        INTEGER issue_id FK\n        INTEGER changed_by FK\n        VARCHAR old_status\n        VARCHAR new_status\n        TIMESTAMP changed_at\n        TEXT remarks\n    }\n\n    NOTIFICATIONS {\n        INTEGER notification_id PK\n        INTEGER user_id FK\n        INTEGER issue_id FK\n        TEXT message\n        VARCHAR notification_type\n        BOOLEAN is_read\n        TIMESTAMP created_at\n    }\n\n    ISSUE_FEEDBACK {\n        INTEGER feedback_id PK\n        INTEGER issue_id FK\n        INTEGER user_id FK\n        INTEGER rating\n        TEXT comment\n        TIMESTAMP created_at\n    }\n\n    USERS ||--o{ ISSUES : reports\n    ISSUES ||--o{ ISSUE_IMAGES : contains\n    DEPARTMENTS ||--o{ STAFF : employs\n    ISSUES ||--o{ ASSIGNMENTS : assigned\n    DEPARTMENTS ||--o{ ASSIGNMENTS : receives\n    STAFF ||--o{ ASSIGNMENTS : handles\n    ISSUES ||--o{ STATUS_HISTORY : tracks\n    USERS ||--o{ STATUS_HISTORY : changes\n    USERS ||--o{ NOTIFICATIONS : receives\n    ISSUES ||--o{ NOTIFICATIONS : generates\n    USERS ||--o{ ISSUE_FEEDBACK : submits\n    ISSUES ||--o{ ISSUE_FEEDBACK : receives&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="PGxtBGnmKhY6ezQ84Kfg-121">
