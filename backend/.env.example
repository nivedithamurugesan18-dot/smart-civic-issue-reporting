# PostgreSQL connection string.
# Replace change_me with the local database password.
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/smart_civic

# Long random value used to sign JWT access tokens.
# Never commit a real secret here.
SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated frontend origins allowed to call the API.
# Local development defaults:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173